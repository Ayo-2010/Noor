rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profile ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['displayName', 'streak', 'dailyGoal', 'level', 'xp']) &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.streak is number && data.dailyGoal is number &&
               data.level is number && data.xp is number;
      }

      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        // Only allow updating stats and active status
        incoming().diff(existing()).affectedKeys().hasAny(['streak', 'dailyGoal', 'level', 'xp', 'versesReadToday', 'lastActive'])
      );
    }

    // --- Reflections ---
    match /reflections/{reflectionId} {
      function isValidReflection(data) {
        return data.keys().hasAll(['userId', 'text', 'verseKey', 'createdAt']) &&
               data.userId is string &&
               data.text is string && data.text.size() <= 5000 &&
               data.verseKey is string && data.verseKey.size() <= 50;
      }

      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && 
                       isValidReflection(incoming()) && 
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt == request.time;
      allow update: if (
        // Action: Edit text
        isOwner(existing().userId) && 
        isValidReflection(incoming()) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['text'])
      ) || (
        // Action: Like
        isSignedIn() && 
        incoming().likesCount == existing().likesCount + 1 && 
        incoming().diff(existing()).affectedKeys().hasOnly(['likesCount'])
      );
      allow delete: if isOwner(existing().userId);
    }

    // --- Notes ---
    match /notes/{noteId} {
      function isValidNote(data) {
        return data.keys().hasAll(['userId', 'verseKey', 'text', 'updatedAt']) &&
               data.userId == request.auth.uid &&
               data.verseKey is string && data.verseKey.size() <= 50 &&
               data.text is string && data.text.size() <= 10000 &&
               data.updatedAt == request.time;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidNote(incoming());
      allow update: if isOwner(existing().userId) && isValidNote(incoming());
      allow delete: if isOwner(existing().userId);
    }

    // --- Bookmarks ---
    match /bookmarks/{bookmarkId} {
      function isValidBookmark(data) {
        return data.keys().hasAll(['userId', 'verseKey', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.verseKey is string && data.verseKey.size() <= 50 &&
               data.createdAt == request.time;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidBookmark(incoming());
      allow delete: if isOwner(existing().userId);
    }

    // --- Collections ---
    match /collections/{collectionId} {
      function isValidCollection(data) {
        return data.keys().hasAll(['userId', 'name', 'createdAt']) &&
               data.userId == request.auth.uid &&
               data.name is string && data.name.size() <= 100 &&
               data.createdAt == request.time;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn(); // Some could be public
      allow create: if isSignedIn() && isValidCollection(incoming());
      allow update: if isOwner(existing().userId) &&
                       isValidCollection(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasAny(['name', 'description', 'image', 'itemCount']);
      allow delete: if isOwner(existing().userId);
    }

    // --- Activities ---
    match /activities/{activityId} {
      function isValidActivity(data) {
        return data.keys().hasAll(['userId', 'type', 'timestamp']) &&
               data.userId == request.auth.uid &&
               data.type in ['read', 'reflection', 'milestone'] &&
               data.timestamp == request.time;
      }

      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidActivity(incoming());
    }
  }
}
